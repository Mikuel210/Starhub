---
interface Props {
    title: string;
    canvasId: string;
}

const { title, canvasId } = Astro.props;
---

<section class="chart">
    <h3>{title}</h3>
    <canvas id={canvasId}></canvas>
</section>

<style>
    section.chart {
        padding: 15px;

        h3 {
            margin: 0;
            margin-bottom: 5px;
            font-size: 15px;
        }

        canvas {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            border: 1px solid white;
        }
    }
</style>
