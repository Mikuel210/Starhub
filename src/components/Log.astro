<section id="section-log">
    <p id="p-log"></p>
</section>

<style>
    #section-log {
        padding: 10px;
        flex: 1;

        > #p-log {
            display: block;
            margin: 0;
            flex: 1;
            padding: 10px;
            overflow-y: auto;

            &::-webkit-scrollbar {
                display: none;
            }
        }
    }
</style>

<script>
    const container = document.getElementById("p-log")!;

    const observer = new MutationObserver(() => {
        container.scrollTop = container.scrollHeight;
    });

    observer.observe(container, { childList: true, subtree: true });
</script>
