---
import { Icon } from "astro-icon/components";
---

<section id="section-countdown">
    <button id="button-countdown-config">
        <Icon name="mdi:cog-outline" />
    </button>

    <h2 id="h2-mission">Mission Name</h2>
    <h2 id="h2-countdown">T-00:00:00</h2>
    <p id="p-milliseconds">000</p>

    <div id="div-countdown-buttons">
        <button id="button-start-abort">START</button>
        <button id="button-hold-resume">HOLD</button>
        <button id="button-stop">STOP</button>
    </div>
</section>

<style>
    #section-countdown {
        align-items: center;
        justify-content: center;
        width: 600px;
        margin-left: auto;
        margin-right: auto;
        margin-top: 30px;

        > #button-countdown-config {
            display: block;
            position: absolute;
            top: 15px;
            right: 15px;
            border: none;
            margin: 0;
            padding: 0;
            background-color: transparent;

            > [data-icon] {
                font-size: 30px;
                color: white;
            }
        }

        > #h2-mission {
            margin: 0;
            padding: 0;
        }

        > #h2-countdown {
            margin: 0;
            padding: 0;
            font-size: 70px;
            line-height: 70px;
        }

        > #p-milliseconds {
            margin: 0;
            font-size: 30px;
        }

        > #div-countdown-buttons {
            margin-top: 15px;

            button {
                width: 125px;
            }
        }
    }
</style>

<script>
    import { state, startupMillis, getT, formatCountdown, setState } from "../scripts/countdown";
    import { connected, lastPacket, writeCommand } from "../scripts/connection";
    import { log } from "../scripts/logger";

    // Countdown configuration
    const configButton = document.getElementById("button-countdown-config") as HTMLButtonElement;
    const missionH2 = document.getElementById("h2-mission") as HTMLHeadingElement;
    const countdownH2 = document.getElementById("h2-countdown") as HTMLHeadingElement;
    const millisecondsP = document.getElementById("p-milliseconds") as HTMLParagraphElement;

    configButton.addEventListener("click", () => {
        const missionName = prompt("Mission Name");

        if (!missionName) {
            alert("No mission name provided");
            return;
        }

        const minutesString = prompt("Countdown Minutes");

        if (!minutesString) {
            alert("No minutes provided");
            return;
        }

        const minutes = parseFloat(minutesString);

        if (isNaN(minutes)) {
            alert("Invalid minutes");
            return;
        }

        if (minutes < 0.5) {
            alert("Minutes must be greater than 0.5");
            return;
        }

        setState({
            configured: true,
            started: false,
            startTime: Date.now(),
            milliseconds: Math.floor(minutes * 60_000),
        });

        missionH2.innerHTML = missionName;
        log(`Mission configured: ${missionName}`);
        requestAnimationFrame(updateCountdown);
    });

    // Start, hold and stop buttons
    const startAbortButton = document.getElementById("button-start-abort") as HTMLButtonElement;
    const holdResumeButton = document.getElementById("button-hold-resume") as HTMLButtonElement;
    const stopButton = document.getElementById("button-stop") as HTMLButtonElement;

    startAbortButton.addEventListener("click", () => {
        if (
            !state.configured ||
            (state.configured && state.started && (state.aborted || state.landed))
        ) {
            return;
        }

        if (!state.started) {
            setState({
                configured: true,
                started: true,
                startTime: Date.now(),
                milliseconds: state.milliseconds,
                hold: false,
                startup: false,
                aborted: false,
                landed: false,
            });

            log("Countdown started");
        } else {
            state.aborted = true;
            writeCommand("A");
            log("Abort triggered");
        }
    });

    holdResumeButton.addEventListener("click", () => {
        if (
            !state.configured ||
            !state.started ||
            (state.configured && state.started && (state.aborted || state.landed))
        ) {
            return;
        }

        if (state.hold) {
            state.startTime = Date.now();
            state.hold = false;
            log("Countdown resumed");
        } else {
            state.milliseconds = -getT();
            state.hold = true;
            log("Hold triggered");
        }
    });

    stopButton.addEventListener("click", () => {
        if (!(
            state.configured &&
            state.started &&
            (state.aborted || state.landed || !state.startup)
        )) {
            return;
        }

        setState({ configured: false });
        missionH2.innerHTML = "Mission Name";
        log("Countdown stopped");
    });

    function updateButtons() {
        // Start / Abort
        if (!state.configured || !connected || (!state.started && lastPacket?.state != 0)) {
            startAbortButton.innerHTML = "START";
            startAbortButton.style.backgroundColor = "silver";
            startAbortButton.style.color = "";
            startAbortButton.disabled = true;
        } else if (state.started && !(state.aborted || state.landed)) {
            startAbortButton.innerHTML = "ABORT";
            startAbortButton.style.backgroundColor = "indianred";
            startAbortButton.style.color = "white";
            startAbortButton.disabled = false;
        } else if (state.started && (state.aborted || state.landed)) {
            startAbortButton.innerHTML = "ABORT";
            startAbortButton.style.backgroundColor = "silver";
            startAbortButton.style.color = "";
            startAbortButton.disabled = true;
        } else {
            startAbortButton.innerHTML = "START";
            startAbortButton.style.backgroundColor = "forestgreen";
            startAbortButton.style.color = "white";
            startAbortButton.disabled = false;
        }

        // Hold / Resume
        const canHold =
            getT() < startupMillis &&
            state.configured &&
            state.started &&
            !state.aborted &&
            !state.landed;

        if (!state.configured || !canHold) {
            holdResumeButton.innerHTML = "HOLD";
            holdResumeButton.style.backgroundColor = "silver";
            holdResumeButton.disabled = true;
        } else if (state.started && state.hold) {
            holdResumeButton.innerHTML = "RESUME";
            holdResumeButton.style.backgroundColor = "skyblue";
            holdResumeButton.disabled = false;
        } else if (state.started && !state.hold) {
            holdResumeButton.innerHTML = "HOLD";
            holdResumeButton.style.backgroundColor = "gold";
            holdResumeButton.disabled = false;
        } else {
            holdResumeButton.innerHTML = "HOLD";
            holdResumeButton.style.backgroundColor = "silver";
            holdResumeButton.disabled = true;
        }

        // Stop
        if (
            state.configured &&
            state.started &&
            (state.aborted || state.landed || !state.startup)
        ) {
            stopButton.style.backgroundColor = "silver";
            stopButton.disabled = false;
        } else {
            stopButton.style.backgroundColor = "silver";
            stopButton.disabled = true;
        }

        // Configure
        if (!state.configured || !state.started) {
            configButton.disabled = false;
        } else {
            configButton.disabled = true;
        }

        requestAnimationFrame(updateButtons);
    }

    function updateCountdown() {
        const { clock, ms } = formatCountdown();
        countdownH2.innerHTML = clock;
        millisecondsP.innerHTML = ms;

        requestAnimationFrame(updateCountdown);
    }

    requestAnimationFrame(updateCountdown);
    requestAnimationFrame(updateButtons);
</script>
