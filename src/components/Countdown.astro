---
import { Icon } from 'astro-icon/components'
---

<section id="section-countdown">
    <button id="button-countdown-config">
        <Icon name="mdi:cog-outline" />
    </button>

    <h2 id="h2-mission">Mission Name</h2>
    <h2 id="h2-countdown">T-00:00:00</h2>
    <p id="p-milliseconds">000</p>

    <div id="div-countdown-buttons">
        <button id="button-start-abort">START</button>
        <button id="button-hold-resume">HOLD </button>
    </div>
</section>

<style>
    #section-countdown {
        align-items: center;
        justify-content: center;
        width: 600px;
        margin-left: auto;
        margin-right: auto;
        margin-top: 30px;

        > #button-countdown-config {
            display: block;
            position: absolute;
            top: 15px;
            right: 15px;
            border: none;
            margin: 0;
            padding: 0;
            background-color: transparent;

            > [data-icon] {
                font-size: 30px;
                color: white;
            }
        }

        > #h2-mission {
            margin: 0;
            padding: 0;
        }

        > #h2-countdown {
            margin: 0;
            padding: 0;
            font-size: 70px;
            line-height: 70px;
        }

        > #p-milliseconds {
            margin: 0;
            font-size: 30px;
        }

        > #div-countdown-buttons {
            margin-top: 15px;

            button {
                width: 125px;
            }
        }
    }
</style>
