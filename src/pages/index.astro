---
import Layout from "../layouts/Layout.astro";
import Countdown from "../components/Countdown.astro";
import Connection from "../components/Connection.astro";
import Log from "../components/Log.astro";
import Chart from "../components/Chart.astro";
---

<Layout>
    <div class="wrapper">
        <div class="top">
            <Connection />
            <Countdown />
            <Log />
        </div>

        <div class="charts">
            <Chart title="Orientation" canvasId="canvas-orientation" />
            <Chart title="Correction" canvasId="canvas-correction" />
            <Chart title="Altitude" canvasId="canvas-altitude" />
            <Chart title="Throttle" canvasId="canvas-throttle" />
            <Chart title="Acceleration" canvasId="canvas-acceleration" />
            <Chart title="Gyroscope" canvasId="canvas-gyroscope" />
            <Chart title="Magnetometer" canvasId="canvas-magnetometer" />
            <Chart title="X Axis PID" canvasId="canvas-x-pid" />
            <Chart title="Y Axis PID" canvasId="canvas-y-pid" />
            <Chart title="Altitude PID" canvasId="canvas-altitude-pid" />
            <Chart title="TVC Servos" canvasId="canvas-tvc" />
            <Chart title="Landing legs" canvasId="canvas-leg" />
            <Chart title="Voltage" canvasId="canvas-voltage" />
            <Chart title="Altitude KF" canvasId="canvas-altitude-kf" />
            <Chart title="Altitude Internals" canvasId="canvas-altitude-internals" />
        </div>
    </div>

    <script src="../scripts/main.ts"></script>
</Layout>

<style>
    div.wrapper {
        min-width: 100dvw;
        margin: 0;
        padding: 0;
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    div.top {
        width: calc(100% - 40px);
        height: 200px;
        margin: 0;
        padding: 10px 20px;
        display: flex;
        flex-direction: row;

        #section-countdown {
            margin: 0 20px;
            width: 600px;
        }
    }

    div.charts {
        width: calc(100% - 40px);
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        grid-template-rows: auto;
        padding: 0 20px;
        gap: 10px;

        section {
            flex: 1;
        }
    }
</style>
