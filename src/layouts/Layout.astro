---
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Starhub</title>
	</head>
	<body>
        <Font cssVariable="--font-main" />
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
        background-color: #141414;
        color: white;
        font-family: var(--font-main);
        overflow-x: hidden;
	}

    section {
        position: relative;
        display: flex;
        flex-direction: column;
        border: 1px solid white;
        border-radius: 20px;
        max-width: 90dvw;
        padding: 30px;
        background-color: #262626;
    }

    button {
        margin: 5px;
        padding: 7px;
        font-size: 20px;
        border: none;
        border-radius: 20px;
        background-color: white;
    }

    button:hover {
        cursor: pointer;
    }
</style>
